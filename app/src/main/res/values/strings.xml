    <!-- 设置：Agent 能力说明 -->
    <string name="agent_guide_title">Agent 能力说明</string>
    <string name="agent_guide_description">灵记有两处 Agent 入口，都能通过工具直接读写笔记；配置辅助模型后，两处 Agent 都会额外获得 subagent 工具。</string>
    <string name="agent_guide_home_title">首页对话 Agent</string>
    <string name="agent_guide_home_entry">位置：首页底部对话栏切换到「Agent」。</string>
    <string name="agent_guide_home_tools">可用工具：笔记管理 list_subjects / create_subject / rename_subject / delete_subject / summarize_all_notes；页面 list_pages / get_page / create_page / update_page / delete_page；碎片 list_fragments / add_fragment / update_fragment / delete_fragment / search_fragments；内容读取与编辑 get_aggregated_note / update_aggregated_note / edit_replace；学习计划 get_study_plan / update_study_plan；检索 get_page_index / search_pages；图片 insert_img。</string>
    <string name="agent_guide_home_tasks">可完成任务：创建、重命名、删除笔记；跨笔记检索与摘要；管理页面和碎片；局部替换编辑笔记内容；生成学习计划；把对话中发送的图片插入笔记本页面。</string>
    <string name="agent_guide_note_title">笔记内对话 Agent</string>
    <string name="agent_guide_note_entry">位置：笔记本或碎片笔记内的对话栏切换到「Agent」模式。</string>
    <string name="agent_guide_note_tools">可用工具：笔记信息 get_subject / rename_subject；页面 list_pages / get_page / create_page / update_page / delete_page；碎片 list_fragments / add_fragment / update_fragment / delete_fragment / search_fragments；内容读取与编辑 get_aggregated_note / edit_replace；学习计划 get_study_plan / update_study_plan；检索 get_page_index / search_pages。</string>
    <string name="agent_guide_note_tasks">可完成任务：在当前笔记内读写页面与碎片；局部替换编辑内容；读取聚合笔记、维护学习计划；按关键词或语义检索本笔记。为限定作用范围，不能新建或删除笔记、生成全局摘要、插入对话图片。</string>
    <string name="agent_guide_subagent">子代理（subagent）：仅在配置辅助模型后可用，用于把独立、多步的子任务交给辅助模型执行；子代理可调用同一套工具，但不能再派生子代理。</string>

