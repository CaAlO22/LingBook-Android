<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Lingji" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- 信息岛：导航栏透明，配合 enableEdgeToEdge 让手势小白条悬浮在内容之上 -->
